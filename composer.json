{
    "name": "manuxi/sulu-content-transfer-bundle",
    "description": "Export and import of Sulu content (articles) between Sulu systems as a single package file.",
    "type": "symfony-bundle",
    "homepage": "https://github.com/manuxi/SuluContentTransferBundle",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "doctrine/orm": "^2.14 | ^3.0",
        "psr/log": "^1.0 | ^2.0 | ^3.0",
        "sulu/sulu": "^3.0",
        "symfony/config": "^6.4 | ^7.0",
        "symfony/console": "^6.4 | ^7.0",
        "symfony/dependency-injection": "^6.4 | ^7.0",
        "symfony/http-foundation": "^6.4 | ^7.0",
        "symfony/http-kernel": "^6.4 | ^7.0",
        "symfony/serializer": "^6.4 | ^7.0",
        "symfony/yaml": "^6.4 | ^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 | ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Manuxi\\SuluContentTransferBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manuxi\\SuluContentTransferBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
